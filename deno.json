{
  "lock": false,
  "imports": {
    "lume/": "https://deno.land/x/lume@v2.5.3/",
    "shikiji/": "https://deno.land/x/lume_shikiji@0.0.7/",
    "theme/": "https://deno.land/x/furiouzz@0.0.12/lume-blog-theme/"
  },
  "tasks": {
    "lume": "echo \"import 'lume/cli.ts'\" | deno run -A - --config .lume/config.ts",
    "build": "deno task lume",
    "dev": "LUME_NOCACHE=true LUME_DRAFTS=true deno task lume -s",
    "deploy": "deno run -A https://deno.land/x/deploy@1.10.0/deployctl.ts deploy"
  },
  "deploy": {
    "project": "chrsmsln-blog",
    "exclude": [
      "**/node_modules"
    ],
    "include": [
      ".lume/serve.ts",
      ".lume/_site/**/*"
    ],
    "entrypoint": ".lume/serve.ts"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "types": [
      "lume/types.ts"
    ]
  }
}
